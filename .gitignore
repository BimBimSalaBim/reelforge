# Generated artefacts
data/
out/
video/build/
video/bin/

# Fonts are fetched at build time (OFL / Bitstream Vera licences), not vendored
docker/fonts/*.ttf

# --- Reel content, all of it generated by the pipeline ---------------------
# This repository is the application, not the reels it produces. Scripts,
# narration, cover art, notes and the finished video are all job output and
# live in data/jobs/<id>/ or out/, never here.
*.mp3
*.mp4
*-reel.png
*-reel-notes.md

# Root-level scripts and caption blocks. The two requirements files are the
# only tracked .txt at the top level.
/*.txt
!/requirements.txt
!/requirements-dev.txt

# Per-reel narration splits. The app writes its own into each job directory.
video/phrases/

# The hand-built storyboards ARE tracked, as worked examples. Three reasons:
# they are the reference implementation of each design language; the code-
# writing model is shown one as its example; and `example_storyboard()` falls
# back to this directory when a name is not in app/templates/examples/, which
# is how the `ledger` (caveman) and `slab` (anydoc) templates resolve theirs.
# The reels themselves -- audio, video, covers, notes -- stay out.
video/storyboards/__pycache__/

# Branding renders
profile-picture.png
pfp-options/

# Repo-page captures for the scrolling B-roll. Generated by
# app/render/reposhot.py per job -- output, not source.
assets/
!assets/.gitkeep

# --- Secrets ---------------------------------------------------------------
# Runtime settings and API keys live in data/ (ignored above): data/settings.yaml
# and data/secrets.json. config.yaml holds no secrets -- only the variable names.
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Local editor/tooling pointer; the real document is DEVELOPMENT.md
CLAUDE.md
