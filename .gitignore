# Generated artefacts
data/
out/
video/build/
video/bin/

# Fonts are fetched at build time (OFL / Bitstream Vera licences), not vendored
docker/fonts/*.ttf

# --- Reel content, all of it generated by the pipeline ---------------------
# This repository is the application, not the reels it produces. Scripts,
# narration, cover art, notes and the finished video are all job output and
# live in data/jobs/<id>/ or out/, never here.
*.mp3
*.mp4
*-reel.png
*-reel-notes.md

# Root-level scripts and caption blocks. The two requirements files are the
# only tracked .txt at the top level.
/*.txt
!/requirements.txt
!/requirements-dev.txt

# Per-reel narration splits and storyboards for the hand-built reels. The app
# writes its own into each job directory. The four storyboards used as worked
# examples for code generation are shipped in app/templates/examples/ instead.
video/phrases/
video/storyboards/

# Branding renders
profile-picture.png
pfp-options/

# --- Secrets ---------------------------------------------------------------
# Runtime settings and API keys live in data/ (ignored above): data/settings.yaml
# and data/secrets.json. config.yaml holds no secrets -- only the variable names.
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Local editor/tooling pointer; the real document is DEVELOPMENT.md
CLAUDE.md
